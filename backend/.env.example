# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_platform

# Docker Engine endpoint.
# Linux/macOS: unix:///var/run/docker.sock
# Windows Docker Desktop: npipe:////./pipe/docker_engine
DOCKER_HOST=unix:///var/run/docker.sock

# Base image used for simulated VMs
VM_BASE_IMAGE=ubuntu:22.04

# Set to false to run Phase 2 only (database records, no containers)
DOCKER_ENABLED=true

# Comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
